ZONAL_REQUIREMENT_ANALYZER_AGENT_ID=
ZONAL_FEATURE_ANALYZER_AGENT_ID=
ZONAL_TESTSPEC_GENERATOR_AGENT_ID=
ZONAL_TESTSPEC_REVIEWER_AGENT_ID=
ZONAL_HISTORICAL_CONTEXT_AGENT_ID=

# ADAS agents
ADAS_REQUIREMENT_CLARIFIER_AGENT_ID=
ADAS_REQUIREMENT_ANALYZER_AGENT_ID=
ADAS_FEATURE_ANALYZER_AGENT_ID=
